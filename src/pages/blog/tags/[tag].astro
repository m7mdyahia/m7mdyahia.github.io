---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag))
    }
  }));
}

type Props = {
  tag: string;
  posts: CollectionEntry<'blog'>[];
};

const { tag, posts } = Astro.props;
const getPostSlug = (id: string) => id.replace(/\.md$/, '');
---

<BaseLayout title={`#${tag} | Blog Articles`} description={`Articles tagged with #${tag}`}>
  <section class="section-heading" style="margin-bottom: 2.5rem;">
    <div style="margin-bottom: 1rem;">
      <a href="/blog/" class="section-link">
        <span aria-hidden="true">←</span>
        <span>Back to all articles</span>
      </a>
    </div>
    <span class="eyebrow">Topic Tag</span>
    <h1 class="hero-title" style="font-size: clamp(2rem, 3.5vw, 2.8rem);">
      #{tag}
    </h1>
    <p class="lead">{posts.length} technical article(s) tagged with #{tag}.</p>
  </section>

  <section class="grid-3">
    {
      posts.map((post) => (
        <a class="article-card" href={`/blog/${getPostSlug(post.id)}/`}>
          <div>
            <div class="article-card-top">
              <span class="article-date">{post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
              <span class="tag-chip">#{tag}</span>
            </div>
            <h3 class="article-title">{post.data.title}</h3>
            <p class="article-desc">{post.data.description}</p>
          </div>

          <div class="article-footer">
            <span class="article-cta">Read article →</span>
          </div>
        </a>
      ))
    }
  </section>
</BaseLayout>

