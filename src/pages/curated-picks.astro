---
import BaseLayout from '../layouts/BaseLayout.astro';
import { recommendations } from '../data/recommendations';

const sortedRecommendations = [...recommendations].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const articleCount = recommendations.filter((r) => r.type === 'article').length;
const bookCount = recommendations.filter((r) => r.type === 'book').length;
const videoCount = recommendations.filter((r) => r.type === 'video').length;
const courseCount = recommendations.filter((r) => r.type === 'course').length;

const finishedCount = recommendations.filter((r) => r.status === 'finished').length;
const inProgressCount = recommendations.filter((r) => r.status === 'in-progress').length;
const todoCount = recommendations.filter((r) => r.status === 'to-do').length;

const typeIcons: Record<string, string> = {
  article: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>`,
  book: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>`,
  video: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>`,
  course: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>`
};

const statusLabels: Record<string, string> = {
  'finished': 'Finished',
  'in-progress': 'In Progress',
  'to-do': 'To Do'
};

const getButtonLabel = (type: string) => {
  switch (type) {
    case 'article':
      return 'Read Article';
    case 'book':
      return 'Explore Book';
    case 'video':
      return 'Watch Video';
    case 'course':
      return 'Open Course';
    default:
      return 'Visit Resource';
  }
};
---

<BaseLayout
  title="Curated Picks | Mohammad Yahia"
  description="Curated picks of standout articles, foundational books, and videos on software engineering, AI, architecture, and craftsmanship."
>
  <section class="section-heading" style="margin-bottom: 2.5rem;">
    <span class="eyebrow">Handpicked Library</span>
    <h1 class="hero-title" style="font-size: clamp(2rem, 3.5vw, 2.8rem);">
      Curated Picks & Deep Dives
    </h1>
    <p class="lead" style="max-width: 52rem;">
      A hand-picked selection of standout articles, foundational books, and insightful videos that have shaped my thinking on software design, AI-driven engineering, and the joy of programming.
    </p>

    <!-- Filters Wrapper -->
    <div class="rec-filters-wrapper" id="filters-wrapper">
      <!-- Type Filter -->
      <div class="rec-filter-group">
        <span class="rec-filter-group-label">Type:</span>
        <button class="rec-filter-btn active" data-group="type" data-filter="all">
          All ({recommendations.length})
        </button>
        <button class="rec-filter-btn" data-group="type" data-filter="article">
          <span set:html={typeIcons.article} />
          #article ({articleCount})
        </button>
        <button class="rec-filter-btn" data-group="type" data-filter="book">
          <span set:html={typeIcons.book} />
          #book ({bookCount})
        </button>
        <button class="rec-filter-btn" data-group="type" data-filter="video">
          <span set:html={typeIcons.video} />
          #video ({videoCount})
        </button>
        {courseCount > 0 && (
          <button class="rec-filter-btn" data-group="type" data-filter="course">
            <span set:html={typeIcons.course} />
            #course ({courseCount})
          </button>
        )}
      </div>

      <!-- Status Filter -->
      <div class="rec-filter-group">
        <span class="rec-filter-group-label">Status:</span>
        <button class="rec-filter-btn active" data-group="status" data-filter="all">
          All Statuses
        </button>
        <button class="rec-filter-btn" data-group="status" data-filter="finished">
          <span class="status-pill-dot" style="background: var(--accent);"></span>
          Finished ({finishedCount})
        </button>
        <button class="rec-filter-btn" data-group="status" data-filter="in-progress">
          <span class="status-pill-dot" style="background: #d97706;"></span>
          In Progress ({inProgressCount})
        </button>
        <button class="rec-filter-btn" data-group="status" data-filter="to-do">
          <span class="status-pill-dot" style="background: var(--muted);"></span>
          To Do ({todoCount})
        </button>
      </div>
    </div>
  </section>

  <div class="recommendations-grid" id="recommendations-list">
    {
      sortedRecommendations.map((rec) => (
        <article class="recommendation-card" data-type={rec.type} data-status={rec.status}>
          <div class="rec-card-main">
            <!-- Header: Type Badge, Status Pill, Author & Date -->
            <div class="rec-card-header">
              <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                <span class:list={['rec-type-badge', `rec-type-${rec.type}`]}>
                  <span set:html={typeIcons[rec.type] ?? typeIcons.article} />
                  <span>#{rec.type}</span>
                </span>
                <span class:list={['status-pill', `status-pill-${rec.status}`]}>
                  <span class="status-pill-dot"></span>
                  <span>{statusLabels[rec.status]}</span>
                </span>
                <span class="rec-author">by <strong>{rec.author}</strong></span>
              </div>
              <span class="rec-date">
                {new Date(rec.date).toLocaleDateString('en-GB', {
                  month: 'short',
                  year: 'numeric'
                })}
              </span>
            </div>

            <!-- Title & Subtitle -->
            <h2 class="rec-title">
              <a href={rec.url} target="_blank" rel="noreferrer">
                {rec.title}
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline-block; vertical-align: middle; margin-left: 0.25rem;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              </a>
            </h2>

            {rec.subtitle && <p class="rec-subtitle">{rec.subtitle}</p>}

            <!-- Summary -->
            <p class="rec-summary">{rec.summary}</p>

            <!-- Personal Reflections / Notes -->
            {rec.thoughts && rec.thoughts.length > 0 && (
              <div class="rec-thoughts-box">
                <div class="rec-thoughts-title">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  <span>Key Takeaways & Reflections</span>
                </div>
                <ul class="rec-thoughts-list">
                  {rec.thoughts.map((thought) => (
                    <li>{thought}</li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Highlight Quote Callout -->
            {rec.quote && (
              <blockquote class="rec-quote-card">
                <p class="rec-quote-text">"{rec.quote.text}"</p>
                <cite class="rec-quote-cite">
                  — {rec.quote.author}
                  {rec.quote.source && <span>, <em>{rec.quote.source}</em></span>}
                </cite>
              </blockquote>
            )}
          </div>

          <!-- Card Footer -->
          <div class="rec-card-footer">
            <div class="article-tags">
              {rec.tags.map((tag) => (
                <a href={`/tags/${tag}/`} class="tag-chip">
                  #{tag}
                </a>
              ))}
            </div>

            <a
              href={rec.url}
              target="_blank"
              rel="noreferrer"
              class="button secondary rec-action-btn"
            >
              <span>{getButtonLabel(rec.type)}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <!-- Client-side filter script supporting dual filtering (Type & Status) -->
  <script is:inline>
    (() => {
      let activeType = 'all';
      let activeStatus = 'all';

      const typeButtons = document.querySelectorAll('.rec-filter-btn[data-group="type"]');
      const statusButtons = document.querySelectorAll('.rec-filter-btn[data-group="status"]');
      const cards = document.querySelectorAll('.recommendation-card');

      const applyFilters = () => {
        cards.forEach((card) => {
          const cardType = card.getAttribute('data-type');
          const cardStatus = card.getAttribute('data-status');

          const matchesType = activeType === 'all' || cardType === activeType;
          const matchesStatus = activeStatus === 'all' || cardStatus === activeStatus;

          if (matchesType && matchesStatus) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      };

      typeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          typeButtons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          activeType = btn.getAttribute('data-filter') || 'all';
          applyFilters();
        });
      });

      statusButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          statusButtons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          activeStatus = btn.getAttribute('data-filter') || 'all';
          applyFilters();
        });
      });
    })();
  </script>
</BaseLayout>
