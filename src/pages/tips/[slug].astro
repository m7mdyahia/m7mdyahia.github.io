---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const tips = await getCollection('tips');
  return tips.map((tip) => ({
    params: { slug: tip.id.replace(/\.md$/, '') },
    props: { tip }
  }));
}

type Props = {
  tip: CollectionEntry<'tips'>;
};

const { tip } = Astro.props;
const { Content } = await render(tip);
const allTips = (await getCollection('tips')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title={`${tip.data.title} | Tips`} description={tip.data.description}>
  <div class="tips-layout">
    <main class="tips-main">
      <article class="card prose">
        <p class="meta">{tip.data.date.toLocaleDateString('en-GB')}</p>
        <h1>{tip.data.title}</h1>
        <p class="lead">{tip.data.description}</p>
        <div class="pills">
          {tip.data.tags.map((tag) => <span class="pill">#{tag}</span>)}
        </div>
        <div style="margin-top: 1.2rem;">
          <Content />
        </div>
      </article>
    </main>

    <BlogSidebar posts={allTips} currentPostId={tip.id} type="tips" />
  </div>
</BaseLayout>

<style>
  .tips-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2.5rem;
  }

  .tips-main {
    min-width: 0;
  }

  @media (max-width: 1040px) {
    .tips-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

