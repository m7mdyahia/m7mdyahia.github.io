---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const blogs = await getCollection('blog');
const tips = await getCollection('tips');
const tags = [...new Set([...blogs.flatMap((item) => item.data.tags), ...tips.flatMap((item) => item.data.tags)])]
  .sort((a, b) => a.localeCompare(b));
---

<BaseLayout title="Architectural Capabilities & Skills Matrix | Mohammad Yahia" description="Full skills, architectural capabilities, and technologies matrix for Mohammad Yahia.">
  <section class="section-heading" style="margin-bottom: 2.5rem;">
    <span class="eyebrow">Engineering Matrix</span>
    <h1 class="hero-title" style="font-size: clamp(2rem, 3.5vw, 2.8rem);">
      Architectural & Technical Capabilities
    </h1>
    <p class="lead" style="max-width: 52rem;">
      A comprehensive map of architecture, platform reliability, streaming ecosystems, infrastructure-as-code, and high-performance computing capabilities.
    </p>
  </section>

  <SkillsGrid skills={profile.skills} />

  <section class="section-container" style="margin-top: 3.5rem;">
    <div class="section-header-flex">
      <div class="section-header-left">
        <span class="eyebrow">Topic Taxonomy</span>
        <h2 class="section-title">Explore Articles by Skill Area</h2>
      </div>
    </div>

    <div class="card">
      <div class="pills">
        {tags.map((tag) => <a class="pill" href={`/tags/${tag}/`}>#{tag}</a>)}
      </div>
    </div>
  </section>
</BaseLayout>

