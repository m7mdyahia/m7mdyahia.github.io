---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Mohammad Yahia - Senior Software Engineer & Architect' } = Astro.props;
const pathname = Astro.url.pathname;

const navItems = [
  { 
    href: '/', 
    label: 'Home',
    icon: `<svg viewBox="0 0 24 24"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>`
  },
  { 
    href: '/blog', 
    label: 'Blog & Articles',
    icon: `<svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>`
  },
  { 
    href: '/tips', 
    label: 'Engineering Tips',
    icon: `<svg viewBox="0 0 24 24"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg>`
  },
  { 
    href: '/curated-picks', 
    label: 'Curated Picks',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`
  },
  { 
    href: '/skills', 
    label: 'Skills Matrix',
    icon: `<svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`
  },
  { 
    href: '/cv', 
    label: 'About & CV',
    icon: `<svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>`
  }
];

const shortcutTags = ['architecture', 'microservices', 'kafka', 'java', 'spring', 'ai', 'aws'];

const socialLinks = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/mohammad-yahia-75b65565/',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 8.5H3.56V20h3.38zm-1.69-5.53A1.97 1.97 0 1 0 5.3 6.9a1.97 1.97 0 0 0-.05-3.93M20.45 20h-3.37v-5.58c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.44-2.14 2.93V20H9.72V8.5h3.24v1.57H13c.45-.86 1.56-1.77 3.22-1.77 3.45 0 4.08 2.27 4.08 5.22z"></path></svg>`
  },
  {
    label: 'GitHub',
    href: 'https://github.com/m7mdyahia',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.6 2 12.26c0 4.53 2.87 8.37 6.84 9.72.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.88-2.78.62-3.37-1.21-3.37-1.21-.46-1.2-1.11-1.53-1.11-1.53-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.04 1.03-2.76-.1-.27-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85 0 1.7.12 2.5.36 1.9-1.33 2.74-1.05 2.74-1.05.55 1.42.2 2.45.1 2.72.64.72 1.03 1.64 1.03 2.76 0 3.93-2.35 4.79-4.59 5.04.36.32.68.93.68 1.88 0 1.36-.01 2.46-.01 2.79 0 .27.18.6.69.49A10.28 10.28 0 0 0 22 12.26C22 6.6 17.52 2 12 2"></path></svg>`
  },
  {
    label: 'Email',
    href: 'mailto:mohammad.yahia.jad@gmail.com',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2m0 1.5v.3l8 5.2 8-5.2v-.3zm16 9V9.58l-7.46 4.85a1 1 0 0 1-1.08 0L4 9.58v6.92z"></path></svg>`
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', saved ?? preferred);
        } catch {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <!-- MOBILE TOP BAR -->
    <header class="mobile-header">
      <div class="mobile-header-inner">
        <a href="/" class="brand-wrapper">
          <img src="/mohammad-yahia.jpg" alt="Mohammad Yahia" class="brand-avatar" style="width: 2rem; height: 2rem;" />
          <span style="font-weight: 700; color: var(--text);">Mohammad Yahia</span>
        </a>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <button class="theme-toggle" id="theme-toggle-mobile" type="button" aria-label="Toggle theme">
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
          <button class="mobile-drawer-toggle" id="drawer-open-btn" aria-label="Open Navigation Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- MOBILE BACKDROP -->
    <div class="mobile-drawer-backdrop" id="drawer-backdrop"></div>

    <div class="app-shell">
      <!-- PERSISTENT LEFT SIDEBAR -->
      <aside class="app-sidebar" id="app-sidebar">
        <div>
          <!-- Profile Card Header -->
          <div class="sidebar-profile">
            <a href="/" style="display: flex; align-items: center; gap: 0.85rem; text-decoration: none;">
              <div class="sidebar-avatar-wrapper">
                <img src="/mohammad-yahia.jpg" alt="Mohammad Yahia" class="sidebar-avatar" />
              </div>
              <div>
                <h2 class="sidebar-name">Mohammad Yahia</h2>
                <div class="sidebar-role">Software Architect</div>
              </div>
            </a>
            
            <div class="sidebar-location">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span>New Cairo, Egypt</span>
            </div>

          </div>

          <!-- Primary Navigation -->
          <nav class="sidebar-nav-section" aria-label="Primary Navigation">
            <span class="sidebar-nav-label">Navigation</span>
            {
              navItems.map((item) => {
                const active = item.href === '/' ? pathname === '/' : pathname === item.href || pathname.startsWith(`${item.href}/`);
                return (
                  <a href={item.href} class:list={{ 'sidebar-nav-item': true, active }}>
                    <span set:html={item.icon} />
                    <span>{item.label}</span>
                  </a>
                );
              })
            }
          </nav>

          <!-- Quick Topic Shortcuts -->
          <div class="sidebar-tags-section">
            <span class="sidebar-nav-label">Core Topics</span>
            <div class="pills" style="gap: 0.35rem; margin-top: 0.5rem;">
              {shortcutTags.map((tag) => (
                <a class="tag-chip" href={`/tags/${tag}/`} style="font-size: 0.72rem;">
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar Bottom Actions & Theme -->
        <div class="sidebar-footer">
          <a class="button secondary" href="/Mohammad_Yahia_CV.pdf" target="_blank" rel="noreferrer" style="width: 100%; font-size: 0.82rem; padding: 0.5rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download Resume (PDF)
          </a>

          <div class="sidebar-theme-row">
            <span style="font-size: 0.8rem; font-weight: 500; color: var(--muted);">Theme</span>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle theme" title="Toggle theme">
                <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="4"></circle>
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                </svg>
                <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
              </button>
            </div>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.5rem;">
            <div class="social-links-row">
              {socialLinks.map((link) => (
                <a class="social-btn" href={link.href} target="_blank" rel="noreferrer" aria-label={link.label} title={link.label} style="width: 2.2rem; height: 2.2rem;" set:html={link.icon} />
              ))}
            </div>
            <span style="font-size: 0.72rem; color: var(--muted);">© 2026</span>
          </div>
        </div>
      </aside>

      <!-- FLUID MAIN CANVAS -->
      <main class="app-main">
        <slot />

        <footer class="site-footer">
          <div class="footer-inner">
            <div class="footer-brand">
              <div>Mohammad Yahia · Senior Software Engineer & Architect</div>
              <div class="footer-meta">Distributed Systems · Cloud Architecture · Engineering Insights</div>
            </div>
            <div class="footer-meta">
              Built with <a href="https://astro.build/" target="_blank" rel="noreferrer">Astro</a> · Hosted on <a href="https://pages.github.com/" target="_blank" rel="noreferrer">GitHub Pages</a>
            </div>
          </div>
        </footer>
      </main>
    </div>

    <!-- SCRIPTS -->
    <script is:inline>
      (() => {
        // Theme toggle logic
        const toggleButtons = [document.getElementById('theme-toggle'), document.getElementById('theme-toggle-mobile')];
        
        const updateTheme = (theme) => {
          document.documentElement.setAttribute('data-theme', theme);
          try {
            localStorage.setItem('theme', theme);
          } catch {}
        };

        toggleButtons.forEach((btn) => {
          if (!btn) return;
          btn.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme') ?? 'light';
            const next = current === 'dark' ? 'light' : 'dark';
            updateTheme(next);
          });
        });

        // Mobile drawer toggle
        const openBtn = document.getElementById('drawer-open-btn');
        const sidebar = document.getElementById('app-sidebar');
        const backdrop = document.getElementById('drawer-backdrop');

        const toggleDrawer = (open) => {
          if (sidebar) sidebar.classList.toggle('open', open);
          if (backdrop) backdrop.classList.toggle('open', open);
        };

        if (openBtn) {
          openBtn.addEventListener('click', () => toggleDrawer(true));
        }
        if (backdrop) {
          backdrop.addEventListener('click', () => toggleDrawer(false));
        }
      })();
    </script>
  </body>
</html>

