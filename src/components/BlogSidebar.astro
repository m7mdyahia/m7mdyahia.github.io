---
interface Props {
  currentPostId?: string;
  posts: any[];
  type: 'blog' | 'tips';
}

const { currentPostId, posts, type } = Astro.props;

const getSlug = (id: string) => id.replace(/\.md$/, '');
const getHref = (id: string) => `/${type}/${getSlug(id)}/`;
---

<aside class="sidebar">
  <div class="sidebar-header">
    <span class="sidebar-badge">{type === 'blog' ? 'Recent Articles' : 'Recent Tips'}</span>
  </div>
  <nav class="sidebar-nav">
    {
      posts.slice(0, 8).map((item) => (
        <a
          href={getHref(item.id)}
          class:list={{
            'sidebar-link': true,
            'active': currentPostId === item.id
          }}
          title={item.data.title}
        >
          <div class="sidebar-link-date">{item.data.date.toLocaleDateString('en-GB')}</div>
          <div class="sidebar-link-title">{item.data.title}</div>
        </a>
      ))
    }
  </nav>
</aside>

<style>
  .sidebar {
    background: var(--surface);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 1.4rem;
    position: sticky;
    top: 5.5rem;
    height: fit-content;
    box-shadow: var(--shadow);
  }

  .sidebar-header {
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .sidebar-badge {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .sidebar-link {
    display: block;
    padding: 0.65rem 0.85rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--text-secondary);
    transition: all 0.15s ease;
    border-left: 2px solid transparent;
  }

  .sidebar-link:hover {
    background-color: var(--accent-soft);
    color: var(--accent);
    transform: translateX(2px);
  }

  .sidebar-link.active {
    background-color: var(--accent-soft);
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 600;
  }

  .sidebar-link-date {
    font-size: 0.72rem;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }

  .sidebar-link-title {
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.35;
    word-break: break-word;
  }
</style>

